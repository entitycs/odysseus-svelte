{
  "name": "odysseus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:widgets": "vite build -c vite.widgets.config.ts",
    "watch:widgets": "vite build -c vite.widgets.config.ts --watch",
    "build:app": "vite build --debug && node scripts/sveltekit-nonce.js",
    "build": "pnpm build:widgets && pnpm build:app",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright install && playwright test",
    "test": "npm run test:e2e",
    "unit": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@fontsource/fira-mono": "^5.2.7",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "css-tree": "^3.2.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
